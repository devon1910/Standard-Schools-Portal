{
  "name": "standard-schools-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app components lib prisma types tests e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs prisma/deploy.ts",
    "db:backfill": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs prisma/backfill.ts",
    "db:seed": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/pg": "^8.23.1",
    "axios": "^1.9.0",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "next-auth": "^4.24.15",
    "perfect-debounce": "1.0.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.2",
    "react-toastify": "^11.0.5",
    "recharts": "^3.2.1",
    "tailwindcss": "^4.1.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.3.2",
    "prisma": "^6.19.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
